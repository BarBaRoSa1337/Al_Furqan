# Expo only receives public runtime endpoint configuration. Do not put Quran
# Foundation credentials in this file.
EXPO_PUBLIC_INITIAL_PACKAGE_ID=surah-al-fil-v1
EXPO_PUBLIC_FURQAN_CONTENT_MODE=preview
# Local preview uses only a verified, bundled 105-114 draft package. It takes
# precedence over EXPO_PUBLIC_FURQAN_API_BASE_URL when both are set.
EXPO_PUBLIC_FURQAN_LOCAL_PREVIEW=true
# EXPO_PUBLIC_FURQAN_API_BASE_URL=http://localhost:8787
