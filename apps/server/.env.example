QF_ENV=prelive
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# PRELIVE English translation verified in the current resource catalog.
QF_TRANSLATION_RESOURCE_ID=85

# Optional resources must be selected explicitly from `npm run server:qf:resources`.
# PRELIVE English tafsir currently exposes 169 (Ibn Kathir Abridged).
QF_TAFSIR_RESOURCE_ID=
# Chapter info: 58=English chapter introductions
QF_CHAPTER_INFO_RESOURCE_ID=58
# Recitation: 6=Al-Husary standard, 12=Al-Husary Muallim
QF_RECITATION_RESOURCE_ID=6
FURQAN_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8083,http://localhost:19006
FURQAN_PORT=8787
FURQAN_ENABLE_DRAFT_RUNTIME=true
