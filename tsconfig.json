{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "allowJs": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "moduleSuffixes": [
      ".native",
      ""
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "expo-module-scripts"
      }
    ]
  },
  "extends": "expo/tsconfig.base",
  "exclude": [
    "check.ts",
    "scratch.ts"
  ]
}
