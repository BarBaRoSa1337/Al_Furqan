        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "الساعة التي تقرع قلوب الناس بأهوالها."
    },
    "101:2": {
      "verses": {
        "101:2": {
          "id": 6159
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "أيُّ شيء هذه القارعة؟"
    },
    "101:3": {
      "verses": {
        "101:3": {
          "id": 6160
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "وأيُّ شيء أعلمك بها؟"
    },
    "101:4": {
      "verses": {
        "101:4": {
          "id": 6161
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "في ذلك اليوم يكون الناس في كثرتهم وتفرقهم وحركتهم كالفراش المنتشر، وهو الذي يتساقط في النار."
    },
    "101:5": {
      "verses": {
        "101:5": {
          "id": 6162
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "وتكون الجبال كالصوف متعدد الألوان الذي يُنْفَش باليد، فيصير هباء ويزول."
    },
    "101:6": {
      "verses": {
        "101:6": {
          "id": 6163
        },
        "101:7": {
          "id": 6164
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."
    },
    "101:7": {
      "verses": {
        "101:6": {
          "id": 6163
        },
        "101:7": {
          "id": 6164
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."
    },
    "101:8": {
      "verses": {
        "101:8": {
          "id": 6165
        },
        "101:9": {
          "id": 6166
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."
    },
    "101:9": {
      "verses": {
        "101:8": {
          "id": 6165
        },
        "101:9": {
          "id": 6166
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."
    },
    "101:10": {
      "verses": {
        "101:10": {
          "id": 6167
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "وما أدراك -أيها الرسول- ما هذه الهاوية؟"
    },
    "101:11": {
      "verses": {
        "101:11": {
          "id": 6168
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "إنها نار قد حَمِيت من الوقود عليها."
    }
  }
}
