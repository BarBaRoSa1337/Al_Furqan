        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "أرأيت حال ذلك الذي يكذِّب بالبعث والجزاء؟"
    },
    "107:2": {
      "verses": {
        "107:2": {
          "id": 6199
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "فذلك الذي يدفع اليتيم الذي مات أبوه وهو صغير بعنف وشدة عن حقه؛ لقساوة قلبه."
    },
    "107:3": {
      "verses": {
        "107:3": {
          "id": 6200
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "ولا يحضُّ غيره على إطعام المحتاج الذي لا يملك ما يكفيه ويسد حاجته، فكيف له أن يطعمه بنفسه؟"
    },
    "107:4": {
      "verses": {
        "107:4": {
          "id": 6201
        },
        "107:5": {
          "id": 6202
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها."
    },
    "107:5": {
      "verses": {
        "107:4": {
          "id": 6201
        },
        "107:5": {
          "id": 6202
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها."
    },
    "107:6": {
      "verses": {
        "107:6": {
          "id": 6203
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "الذين هم يتظاهرون بأعمال الخير مراءاة للناس."
    },
    "107:7": {
      "verses": {
        "107:7": {
          "id": 6204
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "ويمنعون إعارة ما لا تضر إعارته من الآنية وغيرها، فلا هم أحسنوا عبادة ربهم، ولا هم أحسنوا إلى خلقه."
    }
  }
