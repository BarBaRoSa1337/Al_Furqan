{
  "surah": 100,
  "tafsirs": {
    "100:1": {
      "verses": {
        "100:1": {
          "id": 6147
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "أقسم الله تعالى بالخيل الجاريات في سبيله نحو العدوِّ، حين يظهر صوتها من سرعة عَدْوِها. ولا يجوز للمخلوق أن يقسم إلا بالله، فإن القسم بغير الله شرك."
    },
    "100:2": {
      "verses": {
        "100:2": {
          "id": 6148
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "فالخيل اللاتي تنقدح النار من صلابة حوافرها؛ من شدَّة عَدْوها."
    },
    "100:3": {
      "verses": {
        "100:3": {
          "id": 6149
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "فالخيل التي تغير بركبانها على الأعداء عند الصبح."
    },
    "100:4": {
      "verses": {
        "100:4": {
          "id": 6150
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "فهيَّجْنَ بهذا العَدْو غبارًا."
    },
    "100:5": {
      "verses": {
        "100:5": {
          "id": 6151
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "فتوسَّطن بركبانهن جموع الأعداء."
    },
    "100:6": {
      "verses": {
        "100:6": {
          "id": 6152
        },
        "100:7": {
          "id": 6153
        },
        "100:8": {
          "id": 6154
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "إن الإنسان لِنعم ربه لَجحود، وإنه بجحوده ذلك لمقر. وإنه لحب المال لشديد."
    },
    "100:7": {
      "verses": {
        "100:6": {
          "id": 6152
        },
        "100:7": {
          "id": 6153
        },
        "100:8": {
