{
  "surah": 104,
  "tafsirs": {
    "104:1": {
      "verses": {
        "104:1": {
          "id": 6180
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "شر وهلاك لكل مغتاب للناس، طعان فيهم."
    },
    "104:2": {
      "verses": {
        "104:2": {
          "id": 6181
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "الذي كان همُّه جمع المال وتعداده."
    },
    "104:3": {
      "verses": {
        "104:3": {
          "id": 6182
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "يظن أنه ضَمِنَ لنفسه بهذا المال الذي جمعه، الخلود في الدنيا والإفلات من الحساب."
    },
    "104:4": {
      "verses": {
        "104:4": {
          "id": 6183
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "ليس الأمر كما ظن، ليُطرحنَّ في النار التي تهشم كل ما يُلْقى فيها."
    },
    "104:5": {
      "verses": {
        "104:5": {
          "id": 6184
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "وما أدراك -أيها الرسول- ما حقيقة النار؟"
    },
    "104:6": {
      "verses": {
        "104:6": {
          "id": 6185
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "إنها نار الله المشتعلة الشديدة اللهب، التي من شدة حرها تنفُذ من الأجسام إلى القلوب."
    },
    "104:7": {
      "verses": {
        "104:7": {
          "id": 6186
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "إنها نار الله الموقدة التي من شدتها تنفُذ من الأجسام إلى القلوب."
    },
    "104:8": {
      "verses": {
        "104:8": {
          "id": 6187
        },
        "104:9": {
          "id": 6188
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "إنها عليهم مطبَقة في سلاسل وأغلال مطوَّلة؛ لئلا يخرجوا منها."
    },
    "104:9": {
      "verses": {
        "104:8": {
          "id": 6187
        },
        "104:9": {
          "id": 6188
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "إنها عليهم مطبَقة في سلاسل وأغلال مطوَّلة؛ لئلا يخرجوا منها."
    }
  }
}
