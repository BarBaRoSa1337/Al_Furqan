{
  "surah": 102,
  "tafsirs": {
    "102:1": {
      "verses": {
        "102:1": {
          "id": 6169
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "شغلكم عن طاعة الله التفاخر بكثرة الأموال والأولاد."
    },
    "102:2": {
      "verses": {
        "102:2": {
          "id": 6170
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "واستمر اشتغالكم بذلك إلى أن صرتم إلى المقابر، ودُفنتم فيها."
    },
    "102:3": {
      "verses": {
        "102:3": {
          "id": 6171
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "ما هكذا ينبغي أن يُلْهيكم التكاثر بالأموال، سوف تتبيَّنون أن الدار الآخرة خير لكم."
    },
    "102:4": {
      "verses": {
        "102:4": {
          "id": 6172
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "ثم احذروا سوف تعلمون سوء عاقبة انشغالكم عنها."
    },
    "102:5": {
      "verses": {
        "102:5": {
          "id": 6173
        },
        "102:6": {
          "id": 6174
        },
        "102:7": {
          "id": 6175
        },
        "102:8": {
          "id": 6176
        }
      },
      "resource_id": 16,
      "resource_name": "المیسر",
      "language_id": 9,
      "slug": "ar-tafsir-muyassar",
      "translated_name": {
        "name": "Tafsir Muyassar",
        "language_name": "english"
      },
      "text": "ما هكذا ينبغي أن يلهيكم التكاثر بالأموال، لو تعلمون حق العلم لانزجرتم، ولبادرتم إلى إنقاذ أنفسكم من الهلاك. لتبصرُنَّ الجحيم، ثم لتبصرُنَّها دون ريب، ثم لتسألُنَّ يوم القيامة عن كل أنواع النعيم."
    },
