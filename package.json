{
  "name": "quran-habit-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "workspaces": [
    "apps/server",
    "packages/api-contracts"
  ],
  "scripts": {
    "start": "npx expo start",
    "android": "ANDROID_HOME=/usr/lib/android-sdk ANDROID_SDK_ROOT=/usr/lib/android-sdk npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "format:check": "git diff --check",
    "lint": "expo lint --no-cache",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "content:audit": "node --import tsx scripts/audit-content.ts",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "structure:validate": "node --import tsx scripts/validate-quran-structure.ts",
    "structure:import": "node --import tsx scripts/import-quran-foundation-structure.ts",
    "server:dev": "node --import tsx apps/server/src/index.ts",
    "server:test": "node --import tsx --test apps/server/test/*.test.ts",
    "server:typecheck": "tsc -p apps/server/tsconfig.json"
  },
  "dependencies": {
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-modules-core": "~3.0.30",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "<rootDir>/apps/server/"
    ],
    "moduleNameMapper": {
      "^expo-audio$": "<rootDir>/src/test/expoAudioMock.ts"
    }
  },
  "private": true
}
